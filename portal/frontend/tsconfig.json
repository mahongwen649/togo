{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/components/admin/account/**",
    "src/components/account/AccountCapacityCell.vue",
    "src/components/account/AccountStatsModal.vue",
    "src/components/account/AccountTestModal.vue",
    "src/components/account/EditAccountModal.vue",
    "src/components/account/AccountTodayStatsCell.vue",
    "src/components/account/AccountGroupsCell.vue",
    "src/components/account/UpstreamBillingRateCell.vue"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
