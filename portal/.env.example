CORE_BASE_URL=http://host.docker.internal:8080
# Account-package Alipay payments reuse the enabled Core EasyPay provider (read-only).
# Set the public Portal HTTPS origin for gateway notify/return URLs.
PORTAL_PUBLIC_URL=https://your-portal.example.com
# Stable random secret (at least 32 characters). Back up and retain for pending orders.
PORTAL_ACCOUNT_PAYMENT_SECRET=
# 0 selects the first enabled EasyPay/Alipay provider; otherwise pin its Core instance ID.
PORTAL_ACCOUNT_PAYMENT_PROVIDER_ID=0
CORE_ADMIN_API_KEY=admin-replace-with-core-admin-api-key
# Optional read-only Core PostgreSQL connection used by Portal admin recharge reports.
CORE_DATABASE_URL=postgres://sub2api:replace-with-core-db-password@host.docker.internal:5432/sub2api?sslmode=disable

# Portal-owned verification-code password reset. Keep these values secret.
PORTAL_PASSWORD_RESET_SECRET=replace-with-at-least-32-random-characters
PORTAL_TURNSTILE_SECRET=replace-with-cloudflare-turnstile-secret
# Public site key paired with PORTAL_TURNSTILE_SECRET.
PORTAL_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key
PORTAL_SMTP_HOST=smtpdm.aliyun.com
PORTAL_SMTP_PORT=465
PORTAL_SMTP_USERNAME=no-reply@mail.example.com
PORTAL_SMTP_PASSWORD=replace-with-smtp-password
PORTAL_SMTP_FROM=no-reply@mail.example.com
PORTAL_SMTP_FROM_NAME=TogoAPI
PORTAL_SMTP_USE_TLS=true

# Portal-owned low-balance monitor. It reads only official Core APIs and sends
# to the primary account email when the user has no verified Core recipients.
PORTAL_BALANCE_ALERT_ENABLED=false
PORTAL_BALANCE_ALERT_INTERVAL_SECONDS=60


PORTAL_POSTGRES_USER=portal
PORTAL_POSTGRES_PASSWORD=replace-with-a-random-password
PORTAL_POSTGRES_DB=portal

PORTAL_BIND_HOST=127.0.0.1
PORTAL_PORT=3000
TZ=Asia/Shanghai

# Public API gateway shown in documentation and client configuration.
VITE_PUBLIC_API_BASE_URL=https://api.example.com

# Optional registry mirror overrides for networks that cannot reach Docker Hub.
# PORTAL_GOLANG_IMAGE=docker.m.daocloud.io/library/golang:1.23-alpine
# PORTAL_ALPINE_IMAGE=docker.m.daocloud.io/library/alpine:3.21
# PORTAL_NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# PORTAL_NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine

# Embedded third-party card marketplace used by the account business.
ACCOUNT_RECHARGE_URL=https://example.com/merchant/shop
# Exclusive channels stay disabled until all public Core traffic is guarded.
# See docs/exclusive-channels-implementation.md before enabling.
PORTAL_EXCLUSIVE_ENABLED=false
PORTAL_EXCLUSIVE_INGRESS_ISOLATED=false
PORTAL_EXCLUSIVE_PUBLIC_URL=
PORTAL_EXCLUSIVE_SECRET=
PORTAL_SHUTDOWN_TIMEOUT_SECONDS=600
